# ---- AI 호출 설정 (복사해서 .env 로. .env 는 git 에 올리지 않음)
# 개발(GMS)
SVHM_LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
SVHM_LLM_API_KEY=여기에_GMS_키
SVHM_LLM_MODEL=gpt-5
SVHM_LLM_PARAM_STYLE=openai5        # gpt-5 계열: temperature 없음, max_completion_tokens
SVHM_LLM_JSON_MODE=auto             # response_format 지원하면 사용, 안 되면 자동으로 끔
SVHM_LLM_MOCK=0                     # 1 이면 서버 호출 없이 흉내 (테스트)

# 회사 인계 시 (이 세 줄 + PARAM_STYLE 만 바꿈)
# SVHM_LLM_BASE_URL=http://<내부IP>:<port>/v1
# SVHM_LLM_API_KEY=EMPTY
# SVHM_LLM_MODEL=gpt-oss-120b
# SVHM_LLM_PARAM_STYLE=classic
