# Windows에 설치된 MySQL 5.6.19에 직접 접속하는 앱 실행 설정입니다.
# .env.windows로 복사한 뒤 해당 PC의 DB 이름·계정·비밀번호를 입력하세요.
# uv run --locked --env-file .env.windows python -m setron.infrastructure.database
SETRON_DB_HOST=127.0.0.1
SETRON_DB_PORT=3306
SETRON_DB_NAME=setron
SETRON_DB_USER=your_app_user
SETRON_DB_PASSWORD='replace_with_windows_password'
SETRON_DB_CONNECT_TIMEOUT=5
