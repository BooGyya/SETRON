# Windows에 설치된 MySQL 5.6.19에 직접 접속하는 앱 실행 설정입니다.
# 빌드한 dist/SETRON에서 이 파일을 setron.env로 복사한 뒤 DB 이름·계정·비밀번호를 입력하세요.
# 저장소에서 접속 확인: uv run --locked --env-file dist/SETRON/setron.env python -m setron.infrastructure.database
SETRON_DB_HOST=127.0.0.1
SETRON_DB_PORT=3306
SETRON_DB_NAME=setron
SETRON_DB_USER=your_app_user
# 비밀번호 앞뒤에 공백이 있으면 아래처럼 전체를 따옴표로 감싸세요.
SETRON_DB_PASSWORD='replace_with_windows_password'
SETRON_DB_CONNECT_TIMEOUT=5

# 사내 AI. 전달받은 기본 주소(/v1까지)와 키·모델명을 입력하세요.
# 인증이 없고 EMPTY를 허용하는 서버로 확인된 경우에만 API_KEY='EMPTY'로 지정하세요.
# gpt-4는 제공된 사내 예제의 모델명입니다. 실제 서버의 모델명에 맞춰 변경하세요.
SETRON_AI_BASE_URL=
SETRON_AI_API_KEY=
SETRON_AI_MODEL=gpt-4
SETRON_AI_TIMEOUT=60
