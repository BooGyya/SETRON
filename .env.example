# Docker 개발·테스트 DB 설정입니다. 이 파일을 .env로 복사하고 비밀번호 네 개를 바꾸세요.
# .env는 Git에서 제외됩니다. 기존 파일이 있으면 덮어쓰지 말고 필요한 항목만 추가하세요.
# 비밀번호는 작은따옴표로 감싸 $가 환경변수로 치환되지 않도록 합니다.
# 최초 이미지 빌드: docker compose build mysql-dev
# 개발 DB 실행: docker compose up -d --wait mysql-dev
SETRON_DB_HOST=127.0.0.1
SETRON_DB_PORT=13306
SETRON_DB_NAME=setron_dev
SETRON_DB_USER=setron_app
SETRON_DB_PASSWORD='replace_with_dev_password'
SETRON_DB_CONNECT_TIMEOUT=5
SETRON_DB_ROOT_PASSWORD='replace_with_dev_root_password'

# 테스트 DB는 별도 컨테이너와 볼륨을 사용합니다. test 프로필로 실행하세요.
# 실행: docker compose --profile test up -d --wait mysql-test
SETRON_TEST_DB_HOST=127.0.0.1
SETRON_TEST_DB_PORT=13307
SETRON_TEST_DB_NAME=setron_test
SETRON_TEST_DB_USER=setron_test
SETRON_TEST_DB_PASSWORD='replace_with_test_password'
SETRON_TEST_DB_CONNECT_TIMEOUT=5
SETRON_TEST_DB_ROOT_PASSWORD='replace_with_test_root_password'

# 테스트는 프로젝트의 database/schema_mysql5619.sql을 자동으로 사용합니다.
# 앱의 DB 연결 확인:
# uv run --locked --env-file .env python -m setron.infrastructure.database

# 개발용 GMS AI. 실제 GMS Key는 .env에만 입력하세요.
# 모델·시간 제한은 교육 자료 실제 평가에 사용한 값입니다. 팀의 사용 가능 모델을 확인하세요.
SETRON_AI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
SETRON_AI_API_KEY='replace_with_gms_key'
SETRON_AI_MODEL=gpt-6.1-sol
SETRON_AI_TIMEOUT=180
